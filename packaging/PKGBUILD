# Maintainer: S1BERIA
# Local-build PKGBUILD: from a git checkout, run `cd packaging && makepkg -si`.
# Builds the GUI, bundles the CUDA compiler lib (no system CUDA needed), and
# installs a launcher + desktop entry. Models are downloaded on first run into
# the user's data dir — nothing large is shipped in the package.
pkgname=overflow
pkgver=0.2.6
pkgrel=1
pkgdesc="OVERFLOW — S1BERIA's local cybersecurity AI (from-scratch Rust LLM engine + GUI)"
arch=('x86_64')
url="https://github.com/poezi123/PoeziAI"
license=('MIT')
# Runtime: NVIDIA driver provides libcuda; bubblewrap sandboxes shell tools.
depends=('nvidia-utils' 'bubblewrap' 'gcc-libs')
makedepends=('rust' 'cargo' 'python' 'python-pip' 'unzip' 'curl')
options=('!strip' '!lto')

build() {
    cd "$startdir/.."
    cargo build --release -p overflow-gui
    # Vendor the CUDA kernel compiler (libnvrtc) if not already present.
    [ -f vendor/cuda/lib/libnvrtc.so ] || ./scripts/fetch-cuda.sh
}

package() {
    cd "$startdir/.."
    # real binary + bundled CUDA libs
    install -Dm755 target/release/overflow "$pkgdir/usr/lib/overflow/overflow"
    install -d "$pkgdir/usr/lib/overflow/cuda"
    cp -aL vendor/cuda/lib/* "$pkgdir/usr/lib/overflow/cuda/"
    # launcher wrapper
    install -Dm755 packaging/overflow.sh "$pkgdir/usr/bin/overflow"
    # desktop entry + icon
    install -Dm644 packaging/overflow.desktop "$pkgdir/usr/share/applications/overflow.desktop"
    install -Dm644 brand/overflow-mark.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/overflow.svg"
    # optional: training scripts for the Learning tab (advanced; needs a venv)
    install -d "$pkgdir/usr/share/overflow"
    cp -a training "$pkgdir/usr/share/overflow/training" 2>/dev/null || true
    rm -rf "$pkgdir/usr/share/overflow/training/venv" "$pkgdir/usr/share/overflow/training/out" \
           "$pkgdir/usr/share/overflow/training/hf-cache" "$pkgdir/usr/share/overflow/training/data"
    # llama.cpp tools for the Learning tab's GGUF export: the convert scripts
    # (which load gguf-py relative to themselves) and the prebuilt binaries +
    # their shared libs (self-contained in build/bin). The GUI points LC here.
    install -d "$pkgdir/usr/share/overflow/llama.cpp/build/bin"
    install -Dm644 vendor/llama.cpp/convert_hf_to_gguf.py "$pkgdir/usr/share/overflow/llama.cpp/convert_hf_to_gguf.py"
    install -Dm644 vendor/llama.cpp/convert_lora_to_gguf.py "$pkgdir/usr/share/overflow/llama.cpp/convert_lora_to_gguf.py"
    cp -a vendor/llama.cpp/gguf-py "$pkgdir/usr/share/overflow/llama.cpp/gguf-py"
    cp -aL vendor/llama.cpp/build/bin/. "$pkgdir/usr/share/overflow/llama.cpp/build/bin/"
    install -Dm644 README.md "$pkgdir/usr/share/doc/overflow/README.md"

    # bundle the pre-trained model so it ships by default. Built locally by
    # training/build_overflow_wt.sh; if present it goes into the package (~8 GB),
    # installed to the system model dir the GUI scans. If absent, the GUI's
    # first-run download / custom-URL field fetches a model instead.
    if [ -f models/overflow_wt-7b-q8_0.gguf ]; then
        install -Dm644 models/overflow_wt-7b-q8_0.gguf \
            "$pkgdir/usr/share/overflow/models/overflow_wt-7b-q8_0.gguf"
    fi
}

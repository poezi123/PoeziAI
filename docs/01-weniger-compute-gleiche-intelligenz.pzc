@color[green]{●} @small{Eigener Beitrag}

@numbered{
  @item{@bold{CPU-Matmul beschleunigen.} Grundlage des Offloadings. @italic{Umgesetzt: Faktor 4.}}
  @item{@bold{Whole-Layer-Offloading.} 15 GB auf 12 GB bei voller Qualität. @italic{Umgesetzt.}}
  @item{@bold{Sparsität auf dem CPU-Offload-Pfad.} @italic{Umgesetzt als opt-in.}}
  @item{@bold{Sparsity-aware Fine-Tuning.} @italic{Regularizer widerlegt. Mask-aware Training funktioniert: läuft bei keep 0,25 und generalisiert auf ungesehene Aufgaben. Offen: größerer Datensatz, rigorose Qualität, end-to-end-Speed in der Engine.}}
  @item{@bold{Verlustfreie Kompression} (DFloat11-Ansatz), falls die Kernel-Vorgabe gelockert wird.}
  @item{@bold{MoE-Pfad evaluieren.}}
}

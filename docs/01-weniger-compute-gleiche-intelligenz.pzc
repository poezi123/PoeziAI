@title{Weniger Compute, gleiche Intelligenz}
@subtitle{Forschungsstand 2024 bis 2026 zum Betrieb großer Modelle auf schwacher Hardware}
@author{OVERFLOW / PoeziAI}
@date

@block[top=0.5ln]{
  @note{Diese Lektüre ist der Landkarten-Teil unserer Forschung: was es schon gibt, wie gut es zu unseren Randbedingungen passt, und wo echte Lücken bleiben, in denen wir selbst etwas beitragen könnten. Jede Technik ist mit Quellen belegt und ehrlich gegen unsere Situation bewertet.}
}

@toc

@pagebreak

@chapter{Unsere Randbedingungen}

Zwei unserer Regeln sind ungewöhnlich streng und schließen viel Literatur aus: keine Quantisierung (sie würde das Modell dümmer machen) und keine eigenen CUDA-Kernels. Fast alle veröffentlichten GPU-Speedups brauchen maßgeschneiderte Kernels. Reiner Rust lässt uns vor allem auf der Orchestrierungs-Ebene und auf dem CPU-Pfad forschen.

@table[header]{
  @row{Faktor | Bei uns}
  @row{Modell | dichtes Qwen2.5-Coder (7B, perspektivisch 14B\/32B), SwiGLU\/SiLU, kein MoE}
  @row{GPU | RTX 3060, 12 GB (rund 10 GB nutzbar mit Desktop)}
  @row{CPU | rund 37x langsamer pro Token als die GPU}
  @row{Präzision | voll, keine Quantisierung}
  @row{Umsetzung | reiner Rust, keine eigenen CUDA-Kernels}
  @row{Workload | agentisch, eng: Security und Code}
}

@section{Das unmögliche Dreieck}

Von den drei Zielen passt-in-VRAM, volle-Qualität und volle-Geschwindigkeit kann man bei einem dichten Modell, das größer als der VRAM ist, nur zwei gleichzeitig haben, solange man jedes Gewicht bei jedem Token liest. Die ganze Forschung unten ist der Versuch, genau diese letzte Annahme zu brechen.

@section{Was wir selbst gemessen haben}

@list{
  @item{FFN ist rund 87\% der Block-Gewichte, also der Haupthebel.}
  @item{Aktivierungs-Sparsity ist real: nur rund 4,5\% der FFN-Neuronen überschreiten 5\% des Maximums pro Token, rund 35\% überschreiten 1\%.}
  @item{Oracle-Masking: die oberen 50\% der Neuronen zu behalten ist bit-identisch; darunter sinkt die Top-1-Übereinstimmung sanft (25\% ergibt 90\%, 10\% ergibt 78\%).}
  @item{Statischer Skew ist schwach: die 25\% häufigsten Neuronen decken nur rund 39\% der Aktivierungen ab. SiLU liefert kein Power-Law.}
}

@note{Diese Messungen sind genau konsistent mit der Literatur: ein fester Hot-Satz wirkt nur bei ReLU-Modellen; bei SwiGLU muss man magnitude-basiert pro Token vorgehen.}

@chapter{Verlustfreie Gewichts-Kompression}

Die direkteste Antwort auf 15 GB in 12 GB ohne Verlust: das Modell verlustfrei kleiner speichern und beim Rechnen entpacken. Keine Quantisierung, die Ausgabe bleibt bit-identisch.

@list{
  @item{@bold{DFloat11} (NeurIPS 2025). Huffman-Codierung der BF16-Exponenten ergibt rund 30\% kleiner bei bit-identischer Ausgabe. Für uns: 15 GB werden zu rund 10,5 GB und passen in die 3060. @link{https://arxiv.org/pdf/2504.11651}{arxiv.org\/pdf\/2504.11651}}
  @item{@bold{Approaching Shannon Bound} (2026). Treibt die verlustfreie Kompression näher ans Optimum. @link{https://arxiv.org/pdf/2606.15789}{arxiv.org\/pdf\/2606.15789}}
  @item{@bold{NeuZip}. Frühere verlustfreie Kompression, Vergleichsbasis von DFloat11.}
}

@note[Verdict: bedingt]{Konzeptionell perfekt, praktisch mit zwei Haken. Erstens braucht das Entpacken einen GPU-Decode-Kernel, was mit keine-Kernels kollidiert. Zweitens zielt DFloat11 auf BF16, unsere Gewichte sind bereits Q8, die Entropie-Reserve ist kleiner. Für ein unquantisiertes großes Modell ist dies der sauberste Fit-Weg, kostet aber die keine-Kernels-Regel.}

@chapter{Aktivierungs-Sparsity}

Man muss nicht jedes FFN-Neuron rechnen, weil die meisten pro Token fast nichts beitragen. Der Trick ist, das bei SwiGLU\/SiLU (keine harten Nullen) hinzubekommen.

@list{
  @item{@bold{TEAL} (ICLR 2025). Magnitude-basierte Sparsity im ganzen Modell ohne Retraining: 40 bis 50\% modellweit bei minimalem Qualitätsverlust, 1,5x bis 1,8x schneller. Genau unser Masktest-Ergebnis, nur breit validiert. @link{https://arxiv.org/pdf/2408.14690}{arxiv.org\/pdf\/2408.14690}}
  @item{@bold{CATS}. Training-free Sparsity speziell für SwiGLU, Magnitude-Pruning auf dem Wgate-Ausgang, also genau der Stelle, die wir messen.}
  @item{@bold{SparseInfer}. Training-free Vorhersage des aktiven Satzes, ein Prädiktor ohne Training. @link{https://arxiv.org/pdf/2411.12692}{arxiv.org\/pdf\/2411.12692}}
  @item{@bold{Polar Sparsity} (2025). Hochdurchsatz-Variante, verschiebt den Fokus mit der Batch-Größe. @link{https://arxiv.org/pdf/2505.14884}{arxiv.org\/pdf\/2505.14884}}
  @item{Kontext: @bold{DejaVu} und @bold{PowerInfer} nutzen einen festen Hot-Satz, das funktioniert nur bei ReLU-Modellen, nicht bei SwiGLU. Deckt sich mit unserem schwachen Skew.}
}

@note[Verdict: bestätigt aber kernel-abhängig]{TEAL\/CATS zeigen, dass wir 40 bis 50\% der FFN-Rechnung verlustfrei streichen können. Aber Rechnung zu sparen heißt, nur die aktiven Neuron-Zeilen zu laden, und das braucht einen Sparse-Kernel. Auf der GPU unmöglich ohne Kernel; auf der CPU in reinem Rust machbar. Bester pure-Rust-Nutzen: Sparsity auf dem CPU-Offload-Pfad.}

@chapter{Offloading-Systeme}

Modell zwischen GPU und CPU\/RAM aufteilen. Verlustfrei; die Kunst ist, den langsamen Pfad klein zu halten.

@list{
  @item{@bold{PowerInfer}. GPU-CPU-Hybrid über Aktivierungs-Sparsity plus Offline-Neuron-Placement, bis zu 11,69x über llama.cpp auf Consumer-GPU. @link{https://ipads.se.sjtu.edu.cn/_media/publications/powerinfer-20231219.pdf}{ipads.se.sjtu.edu.cn}}
  @item{@bold{PowerInfer-2}. Dieselbe Idee auf Smartphones.}
  @item{@bold{llama.cpp}. Der Standard: ganze Layer auf GPU, Rest auf CPU. Durch PCIe und schwache CPU limitiert, genau unsere Prognose.}
  @item{@bold{DynamicInfer} (ICLR 2026). Dynamisches Placement zur Laufzeit. @link{https://openreview.net/pdf/e9b26b26d8a26d5844d0e52a27b30b35f86e875d.pdf}{openreview.net}}
  @item{@bold{PIPO}, @bold{FlexInfer}, @bold{NEO}, @bold{FlexGen}. Pipelined Offloading, Transfer-Compute-Overlap, CPU-Offloading gegen die GPU-Memory-Crisis. @link{https://arxiv.org/pdf/2504.03664}{PIPO}, @link{https://arxiv.org/pdf/2411.01142}{NEO}}
}

@note[Verdict: passt und pure Rust]{Der robuste Fit-Weg: ganze Layer GPU\/CPU, bestehende Kernels wiederverwenden. Ehrlicher Speed: rund 2 bis 3 Token pro Sekunde beim 15-GB-Modell, weil die CPU der Flaschenhals ist. PowerInfers 11x gelten für ReLU plus eigene Kernels, nicht übertragbar. Direkter pure-Rust-Hebel: den CPU-Matmul beschleunigen.}

@chapter{Spekulatives Decoding}

Mehrere Token auf einmal erzeugen und in einem Pass prüfen. Bei Temperatur 0 verlustfrei. Haben wir schon (Prompt-Lookup, 1,67x auf Reuse-Workloads).

@list{
  @item{@bold{Prompt-Lookup} und @bold{Lookahead}. Kein zweites Modell; Entwürfe aus dem Kontext. Unser Ansatz.}
  @item{@bold{Medusa}. Leichte Draft-Heads direkt am Zielmodell.}
  @item{@bold{EAGLE / EAGLE-2 / EAGLE-3}. Aktueller SOTA, rund 1,98x; EAGLE-3 sagt Token direkt voraus. @link{https://arxiv.org/pdf/2503.01840}{EAGLE-3}, @link{https://arxiv.org/pdf/2406.16858}{EAGLE-2}}
  @item{Survey EMNLP-Findings 2025. @link{https://aclanthology.org/2025.findings-emnlp.716.pdf}{aclanthology.org}}
}

@note[Verdict: erledigt]{Mit der einfachsten, trainingsfreien Variante umgesetzt. EAGLE-3 wäre stärker, braucht aber ein trainiertes Draft-Head, was zu unserer QLoRA-Pipeline passt und keinen Kernel erfordert.}

@chapter{KV-Cache-Kompression}

Betrifft nicht die Gewichte, sondern den mit der Kontextlänge wachsenden KV-Cache. Relevant für lange Agent-Sessions.

@list{
  @item{@bold{StreamingLLM}. Nur erste und letzte Token behalten (Attention-Sinks).}
  @item{@bold{H2O} und @bold{SnapKV}. Wichtige KV-Positionen pro Head auswählen.}
  @item{@bold{PyramidKV}. Pro Layer unterschiedlich stark kürzen. @link{https://arxiv.org/pdf/2406.02069}{arxiv.org\/pdf\/2406.02069}}
  @item{@bold{KIVI}. KV quantisieren (nicht unser Pfad, da Qualität).}
  @item{@bold{THINK}. Query-abhängiges KV-Pruning.}
}

@note[Verdict: später relevant]{Nützlich, wenn Agenten über den 4096-Token-Cache hinaus laufen. Für das 15-GB-Fit-Problem nicht der Hebel.}

@chapter{Adaptive Rechentiefe}

@list{
  @item{@bold{Mixture-of-Depths} (Raposo 2024). Nicht jedes Token durchläuft jeden Layer.}
  @item{@bold{Mixture-of-Recursions} (2025). Geteilter Layer-Stack, pro Token dynamische Rekursionstiefe. @link{https://arxiv.org/pdf/2507.10524}{arxiv.org\/pdf\/2507.10524}}
  @item{@bold{AdaPonderLM} (2026). Token-weise Tiefe mit gated pondering.}
  @item{@bold{Early-Exit}. Frühzeitig aussteigen, wenn ein Token sicher ist.}
}

@note[Verdict: Architektur oder Training]{Braucht ein anders trainiertes Modell. Early-Exit-artiges ließe sich perspektivisch mit unserer Pipeline aufsetzen, ist aber ein großes, unsicheres Projekt.}

@chapter{MoE statt dicht}

Wenn groß und schnell das Ziel ist, ist die sauberste Antwort oft kein dichtes Modell, sondern MoE: 15 GB gesamt, aber nur rund 3 GB pro Token aktiv.

@list{
  @item{@bold{MoE-Infinity}. Experten in RAM\/SSD auslagern, heiße Experten GPU-resident, Prefetch versteckt Transfers. @link{https://github.com/EfficientMoE/MoE-Infinity/}{github.com\/EfficientMoE\/MoE-Infinity}}
  @item{@bold{DALI}. Workload-bewusstes MoE-Offloading für lokale PCs. @link{https://arxiv.org/pdf/2602.03495}{arxiv.org\/pdf\/2602.03495}}
  @item{@bold{HybriMoE} (DAC 2025) und @bold{fMoE}. CPU-GPU-Scheduling und fein-granulares Experten-Offloading.}
}

@note[Verdict: strategisch interessant]{Ein MoE-Code-Modell mit Experten-Offloading könnte groß-und-flott auf 12 GB besser lösen als dichtes Offloading, der aktive Satz passt in den VRAM. Setzt voraus, dass wir von dichtem Qwen2.5 weggehen.}

@chapter{Domänen-Spezialisierung}

Wichtig fürs ehrliche Bild: Die Idee, dass unser enger Agent einen kleineren, stabileren aktiven Satz hat, gibt es bereits.

@list{
  @item{@bold{SEAP}. Training-free Pruning task-spezifischer Neuronen über Aktivierungsmuster. @link{https://arxiv.org/pdf/2402.14800}{emergentmind\/2402.14800}}
  @item{@bold{DieT (Diet Your LLM)}. Profiliert Aktivierungs-Magnituden über Tasks mit rund 100 Samples und baut eine globale Maske. @link{https://arxiv.org/html/2603.23985v1}{arxiv.org\/html\/2603.23985v1}}
  @item{@bold{Half the Experts, All the Code}. One-Shot-Domänen-Pruning von MoE fürs Coding. @link{https://arxiv.org/pdf/2607.16721}{arxiv.org\/pdf\/2607.16721}}
  @item{@bold{TrimLLM}. Progressives Layer-Dropping für domänenspezifische LLMs (ACL 2025).}
}

@warning[Eigenes Experiment: negatives Ergebnis]{Wir haben einen Hot-Satz aus Security\/Code-Prompts gelernt und seine Abdeckung auf anderen Security\/Code-Prompts gegen generischen Text gemessen (hot 25\%): Domäne 36,1\% gegen generisch 33,0\%, Gap nur 3,0 Prozentpunkte, nicht besser als die 39\%-Baseline. Der Hot-Satz ist nicht domänenspezifisch. Statisches Domänen-Offloading ist bei diesem dichten SiLU-Modell tot. Die eine potenziell originelle Idee ist damit empirisch widerlegt.}

@chapter{Ehrliche Synthese}

Praktisch jeder Hebel, den wir diskutiert haben, ist publiziert: spekulatives Decoding, Aktivierungs-Sparsity (TEAL\/CATS), Prädiktoren, Offloading, verlustfreie Kompression, KV-Kompression, MoE-Offloading, Domänen-Pruning. Die echte, unterbeleuchtete Lücke liegt nicht in einer neuen Technik, sondern in unserem Regime.

@numbered{
  @item{@bold{Schwache GPU plus sehr langsame CPU plus keine eigenen Kernels.} Ob die Methoden der Literatur unter reiner Orchestrierung auf einer 3060 netto noch gewinnen, ist kaum untersucht.}
  @item{@bold{Ein einzelner, eng spezialisierter, selbst fine-getunter Agent.} Unser Test zeigt: die Domäne allein erzeugt keine Struktur. Also müsste man sie hineintrainieren. Die eine verbliebene originelle Richtung: Sparsity aktiv ins Fine-Tuning hineintrainieren, sodass der Agent lernt, scharf und stabil sparse zu feuern.}
  @item{@bold{Ein ehrlich gemessener, kombinierter Stack} für genau dieses Gerät: verlustfreie Kompression mal Aktivierungs-Sparsity mal spekulatives Decoding, end-to-end auf einer 3060 vermessen.}
}

@note{Nüchtern: Einen echten algorithmischen Durchbruch sollten wir nicht versprechen. Realistisch ist ein origineller Systems- und Empirie-Beitrag im Low-End- und Single-Agent-Regime, plus ein möglicherweise neuer Dreh beim sparsity-aware Fine-Tuning unseres eigenen Agenten.}

@chapter{Empfohlene Forschungsagenda}

Reihenfolge nach Nutzen geteilt durch Risiko:

@numbered{
  @item{@bold{CPU-Matmul beschleunigen} (reiner Rust, risikoarm, hoher Hebel). Der CPU-Pfad limitiert jedes Offloading. SIMD, Cache-Blocking, Threading. Fundament für alles Offloading.}
  @item{@bold{Whole-Layer-Offloading} (reiner Rust, Fit-Ziel). Erreicht 15 GB in 12 GB bei voller Qualität, rund 2 bis 3 Token pro Sekunde.}
  @item{@bold{Sparsity auf dem CPU-Offload-Pfad.} Ausgelagerte FFN-Layer nur ihren aktiven Teil rechnen lassen, verlustfrei laut unserem Masktest.}
  @item{@bold{Sparsity-aware Fine-Tuning} (nutzt unsere QLoRA-Pipeline, möglicher Eigenbeitrag). Den Agenten so trainieren, dass seine Aktivierungen schärfer und stabiler werden.}
  @item{@bold{DFloat11-artige verlustfreie Kompression}, falls wir die keine-Kernels-Regel hierfür lockern.}
  @item{@bold{MoE-Pfad evaluieren.} Ein MoE-Code-Modell plus Experten-Offloading könnte das Problem fundamental besser lösen.}
}


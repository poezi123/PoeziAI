  @item{@bold{Whole-Layer-Offloading}. 15 GB in 12 GB bei voller Qualität. @italic{Erledigt.}}
  @item{@bold{Sparsity auf dem CPU-Offload-Pfad.} @italic{Erledigt als opt-in, near-lossless.}}
